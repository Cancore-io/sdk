{
  "name": "cancore-sdk",
  "private": true,
  "description": "Cancore SDK \u2014 the packages a third-party dApp or a wallet build installs from npm.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cancore-io/sdk.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "jest",
    "typecheck": "tsc --build --force",
    "clean": "rm -rf packages/*/dist"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@swc/core": "^1.7.0",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "tsup": "^8.3.0",
    "typescript": "^5.9.0"
  }
}
