{
  "name": "cancore-sdk",
  "private": true,
  "version": "0.1.0",
  "description": "Cancore SDK — the packages a third-party dApp or a wallet build installs from npm.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cancore-io/sdk.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "jest",
    "typecheck": "tsc --build --force && tsc --noEmit -p packages/wallet/tsconfig.json",
    "clean": "rm -rf packages/*/dist",
    "release:connector": "npm publish -w @cancore/dapp-connector --access public",
    "release:wallet": "npm publish -w @cancore/wallet --access public"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@swc/core": "^1.7.0",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.12",
    "@types/node": "^26.4.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.5.1",
    "tsup": "^8.3.0",
    "typescript": "^5.9.0"
  }
}
