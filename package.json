{
  "name": "cancore-sdk",
  "private": true,
  "version": "0.1.0",
  "description": "Cancore SDK — the packages a third-party dApp or a wallet build installs from npm.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cancore-io/sdk.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "jest --selectProjects node web",
    "typecheck": "tsc --build --force && tsc --noEmit -p packages/mcp/tsconfig.json && tsc --noEmit -p packages/wallet/tsconfig.json && tsc --noEmit -p packages/client/tsconfig.json && tsc --noEmit -p packages/contracts/tsconfig.json && tsc --noEmit -p packages/trader/tsconfig.json && tsc --noEmit -p packages/botd/tsconfig.json && tsc --noEmit -p packages/bot-mcp/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "loc:check": "node scripts/quality-gates.ts loc",
    "loc:check:update": "node scripts/quality-gates.ts loc --update",
    "complexity:check": "node scripts/quality-gates.ts complexity",
    "complexity:check:update": "node scripts/quality-gates.ts complexity --update",
    "any:check": "node scripts/quality-gates.ts any",
    "any:check:update": "node scripts/quality-gates.ts any --update",
    "coverage:check": "node scripts/quality-gates.ts coverage",
    "coverage:check:update": "node scripts/quality-gates.ts coverage --update",
    "clean": "rm -rf packages/*/dist",
    "release:connector": "pnpm --filter @cancore/dapp-connector publish --access public",
    "release:mcp": "pnpm --filter @cancore/mcp publish --access public",
    "release:wallet": "pnpm --filter @cancore/wallet publish --access public",
    "release:client": "pnpm --filter @cancore/client publish --access public",
    "release:contracts": "pnpm --filter @cancore/contracts publish --access public",
    "test:int": "jest --selectProjects int",
    "test:security:root": "bash packages/botd/test/security/root.sh",
    "test:systemd": "bash packages/botd/test/systemd/unit-start.sh"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "@swc/core": "^1.7.0",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.12",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ethers": "^6.17.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.5.1",
    "selfsigned": "^2.4.1",
    "socket.io-client": "^4.8.3",
    "tsup": "^9.0.0",
    "typescript": "^5.9.0",
    "undici": "^8.12.4"
  }
}
