{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cancore.io/schemas/filler-protocol/v1/rest.schema.json",
  "title": "Cancore filler protocol v1 — REST fallback",
  "$comment": "protocol §3.6. Bodies are the WebSocket frames: every request body is a filler message with its envelope (id, fillerId, sentAt) and msgSig, verified before processing as on the WebSocket (S-19); every response is a freshly signed S→F message. Login: GET /v1/filler/auth/challenge?fillerId= returns a signed auth.challenge addressed to that fillerId; POST /v1/filler/auth with the auth.response (FillerAuth over it) returns {token, expiresAt}. The challenge route is anonymous and its refusals are UNSIGNED (unsignedErrorBody, no sig, nothing journalled): 400 BAD_REQUEST — fillerId missing or not a fillerId; 404 UNKNOWN_REQUEST — fillerId unknown or not ACTIVE; the anonymous login steps are charged to no fillerId's rate limits (knowing a fillerId cannot lock its filler out); a 429 here comes only from the per-IP limit in front of filler-gateway. POST /v1/filler/auth refuses UNSIGNED too as long as it has checked no signature: 400 BAD_REQUEST — no or a malformed fillerId; 404 UNKNOWN_REQUEST — fillerId unknown or not ACTIVE; 401 UNAUTHENTICATED — the fillerId holds no live challenge (evicted, expired or used: ask for a new one). Its refusals after the signature checks (BAD_SIGNATURE, STALE_MESSAGE, REPLAYED_MESSAGE, UNSUPPORTED_VERSION, NOT_ELIGIBLE, UNAUTHENTICATED) are the signed error. The other /v1/filler/* routes need `Authorization: Bearer <token>`; the token is bound to (fillerId, message key) and stops working when it expires, when the message key is changed, or when the filler is no longer ACTIVE. The same token opens the WebSocket (asyncapi.json: offered as the subprotocol bearer.<token>). A ticket of another filler is 404 UNKNOWN_TICKET. Rate limits are per fillerId and rate class (quote, ticket, service, read for every bearer GET, login, cantonPrepare for canton.prepare of §3.19 — an hourly budget per filler, 60 by default — and canton for canton.submit, so a spent prepare budget never holds back the submit of an operation already prepared), shared by REST and every WebSocket session of it: over the limit a bearer route answers 429 with an UNSIGNED unsignedErrorBody {type: error, code: RATE_LIMITED, message, retryAfterMs} and a Retry-After header (seconds, rounded up), journals nothing one by one, and the request changes nothing; during the cooldown after sustained excess every bearer route answers so. Every 429 is unsigned, on every route; a filler decides by the status and takes retryAfterMs (else Retry-After) as a hint. Every other non-2xx of a bearer route is the signed error. GET /v1/filler/attestations/{orderHash} answers 404 ATTESTATIONS_NOT_READY until the gateway holds ≥ threshold verified signatures for this filler's fill, and 404 UNKNOWN_TICKET when this filler holds no ticket on the order. /v1/filler/canton/* (§3.19) serve only the caller's own party: POST prepare and submit take the canton.prepare and canton.submit messages and answer canton.prepared and canton.submitted (the same frames as on the WebSocket); GET party, holdings, delivery-orders and intents/{orderHash} read the party registered for the fillerId, and answer 409 CANTON_NOT_READY while it has none; intents/{orderHash} answers 404 UNKNOWN_TICKET when no live SwapIntent with that orderHash names the party. /v1/draws/* and /v1/gateway are public. Every non-2xx body is the signed `error` frame, with the HTTP status of x-error-status — except a 429 (always unsignedErrorBody) and the unsigned refusals of an endpoint that names an errorBody. x-endpoints: request/query/response/errorBody name a $def here or in messages.schema.json.",
  "x-endpoints": [
    { "method": "GET", "path": "/v1/filler/auth/challenge", "auth": "none", "query": "#/$defs/challengeQuery", "response": "messages.schema.json#/$defs/auth.challenge", "errorBody": "#/$defs/unsignedErrorBody" },
    { "method": "POST", "path": "/v1/filler/auth", "auth": "none", "request": "messages.schema.json#/$defs/auth.response", "response": "#/$defs/authToken", "errorBody": "#/$defs/unsignedErrorBody" },
    { "method": "GET", "path": "/v1/filler/tickets", "auth": "bearer", "query": "#/$defs/ticketListQuery", "response": "#/$defs/ticketList" },
    { "method": "POST", "path": "/v1/filler/tickets/{orderHash}/{attempt}/intent", "auth": "bearer", "request": "messages.schema.json#/$defs/ticket.intent", "response": "messages.schema.json#/$defs/ticket.intent.ack" },
    { "method": "POST", "path": "/v1/filler/tickets/{orderHash}/{attempt}/receipt", "auth": "bearer", "request": "messages.schema.json#/$defs/ticket.receipt", "response": "#/$defs/empty" },
    { "method": "POST", "path": "/v1/filler/tickets/{orderHash}/{attempt}/decline", "auth": "bearer", "request": "messages.schema.json#/$defs/ticket.decline", "response": "#/$defs/empty" },
    { "method": "POST", "path": "/v1/filler/stake-bindings", "auth": "bearer", "request": "#/$defs/stakeBindingRequest", "response": "#/$defs/empty" },
    { "method": "GET", "path": "/v1/filler/quotes", "auth": "bearer", "query": "#/$defs/quoteListQuery", "response": "#/$defs/quoteList" },
    { "method": "GET", "path": "/v1/filler/stats", "auth": "bearer", "response": "#/$defs/fillerStats" },
    { "method": "GET", "path": "/v1/filler/penalties", "auth": "bearer", "query": "#/$defs/pageQuery", "response": "#/$defs/penaltyList" },
    { "method": "GET", "path": "/v1/filler/attestations/{orderHash}", "auth": "bearer", "response": "messages.schema.json#/$defs/settle.attestations" },
    { "method": "GET", "path": "/v1/draws/{orderHash}", "auth": "none", "response": "records.schema.json#/$defs/drawRecord" },
    { "method": "GET", "path": "/v1/draws/epochs/{id}", "auth": "none", "response": "records.schema.json#/$defs/epochRecord" },
    { "method": "GET", "path": "/v1/gateway", "auth": "none", "response": "records.schema.json#/$defs/gatewayInfo" },
    { "method": "POST", "path": "/v1/filler/canton/prepare", "auth": "bearer", "request": "messages.schema.json#/$defs/canton.prepare", "response": "messages.schema.json#/$defs/canton.prepared" },
    { "method": "POST", "path": "/v1/filler/canton/submit", "auth": "bearer", "request": "messages.schema.json#/$defs/canton.submit", "response": "messages.schema.json#/$defs/canton.submitted" },
    { "method": "GET", "path": "/v1/filler/canton/party", "auth": "bearer", "response": "#/$defs/cantonParty" },
    { "method": "GET", "path": "/v1/filler/canton/holdings", "auth": "bearer", "query": "#/$defs/pageQuery", "response": "#/$defs/cantonHoldingList" },
    { "method": "GET", "path": "/v1/filler/canton/delivery-orders", "auth": "bearer", "query": "#/$defs/pageQuery", "response": "#/$defs/cantonDeliveryOrderList" },
    { "method": "GET", "path": "/v1/filler/canton/intents/{orderHash}", "auth": "bearer", "response": "#/$defs/cantonIntent" }
  ],
  "x-error-status": {
    "BAD_REQUEST": 400, "UNAUTHENTICATED": 401, "UNSUPPORTED_VERSION": 400, "UNSUPPORTED_TYPE": 400, "BAD_SIGNATURE": 422,
    "STALE_MESSAGE": 400, "REPLAYED_MESSAGE": 409, "TICKET_REFUSED": 409, "UNKNOWN_REQUEST": 404, "UNKNOWN_TICKET": 404, "TICKET_CLOSED": 409, "NOT_ELIGIBLE": 403, "RATE_LIMITED": 429, "INTERNAL": 500,
    "ATTESTATIONS_NOT_READY": 404, "CANTON_NOT_READY": 409, "CANTON_REFUSED": 422, "CANTON_UNAVAILABLE": 503, "OPERATION_EXPIRED": 410
  },
  "$defs": {
    "errorBody": { "$ref": "messages.schema.json#/$defs/errorS2F" },
    "unsignedErrorBody": {
      "type": "object",
      "description": "An unsigned refusal: every 429, and the refusals of the login routes decided before any signature check. Not signed, not addressed, nothing journalled; a filler cannot verify it and treats it as a hint only (status, code, retryAfterMs)",
      "required": ["type", "code", "message"],
      "properties": {
        "type": { "const": "error" },
        "code": { "$ref": "messages.schema.json#/$defs/errorCode" },
        "message": { "type": "string" },
        "retryAfterMs": { "$ref": "messages.schema.json#/$defs/durationMs", "type": "integer", "minimum": 1, "description": "with RATE_LIMITED (429): ms until the rate class may be used again" }
      }
    },
    "challengeQuery": {
      "type": "object",
      "required": ["fillerId"],
      "properties": { "fillerId": { "$ref": "messages.schema.json#/$defs/fillerId", "description": "the filler logging in; the challenge is addressed to it and answerable only by it" } }
    },
    "empty": { "type": "object", "description": "no fields in v1; receivers ignore unknown ones (V-2)" },
    "authToken": {
      "type": "object",
      "required": ["token", "expiresAt"],
      "properties": { "token": { "type": "string", "minLength": 1 }, "expiresAt": { "$ref": "messages.schema.json#/$defs/timeMs" } }
    },
    "pageQuery": {
      "type": "object",
      "properties": { "cursor": { "type": "string", "minLength": 1 }, "limit": { "type": "string", "pattern": "^([1-9][0-9]?|100)$", "description": "1..100, default 50" } }
    },
    "ticketListQuery": {
      "allOf": [{ "$ref": "#/$defs/pageQuery" }],
      "type": "object",
      "properties": { "status": { "enum": ["OFFERED", "ISSUED"], "description": "a request filter: the gateway owns the list, so it is closed" } }
    },
    "quoteListQuery": {
      "allOf": [{ "$ref": "#/$defs/pageQuery" }],
      "type": "object",
      "properties": { "since": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$", "description": "unix ms" } }
    },
    "ticketList": {
      "type": "object",
      "required": ["items", "nextCursor"],
      "properties": {
        "items": {
          "type": "array",
          "items": { "oneOf": [{ "$ref": "messages.schema.json#/$defs/ticket.offer" }, { "$ref": "messages.schema.json#/$defs/ticket.issued" }] }
        },
        "nextCursor": { "type": ["string", "null"] }
      }
    },
    "stakeBindingRequest": {
      "type": "object",
      "description": "sig = StakeBinding{partnerId, stakingAddress, chainId, nonce} by the staking address; the body carries the filler envelope and msgSig like every request body",
      "allOf": [{ "$ref": "messages.schema.json#/$defs/f2sEnvelope" }],
      "required": ["partnerId", "stakingAddress", "chainId", "nonce", "sig"],
      "properties": {
        "partnerId": { "$ref": "messages.schema.json#/$defs/fillerId" },
        "stakingAddress": { "$ref": "messages.schema.json#/$defs/address" },
        "chainId": { "$ref": "messages.schema.json#/$defs/uintDec256" },
        "nonce": { "$ref": "messages.schema.json#/$defs/uintDec64" },
        "sig": { "$ref": "messages.schema.json#/$defs/sig65" }
      }
    },
    "quoteRecord": {
      "type": "object",
      "required": ["quote", "ack", "status"],
      "properties": {
        "quote": { "$ref": "messages.schema.json#/$defs/quote" },
        "ack": { "$ref": "messages.schema.json#/$defs/quote.ack" },
        "status": { "anyOf": [{ "enum": ["COUNTED", "LATE", "SHORT_TTL", "REPLACED", "BAD_SIG", "OUTLIER", "IN_BAND", "OUT_OF_BAND", "WON", "LOST"] }, { "$ref": "messages.schema.json#/$defs/futureEnumValue" }] }
      }
    },
    "quoteList": {
      "type": "object",
      "required": ["items", "nextCursor"],
      "properties": { "items": { "type": "array", "items": { "$ref": "#/$defs/quoteRecord" } }, "nextCursor": { "type": ["string", "null"] } }
    },
    "fillerStats": {
      "type": "object",
      "required": ["won", "delivered", "noShow", "reliability", "capacityUsd", "inFlightUsd"],
      "properties": {
        "won": { "type": "integer", "minimum": 0 },
        "delivered": { "type": "integer", "minimum": 0 },
        "noShow": { "type": "integer", "minimum": 0 },
        "reliability": { "type": "integer", "minimum": 0, "maximum": 10000, "description": "basis points" },
        "capacityUsd": { "$ref": "messages.schema.json#/$defs/intDecUsd" },
        "inFlightUsd": { "$ref": "messages.schema.json#/$defs/intDecUsd" }
      }
    },
    "penaltyRecord": {
      "type": "object",
      "required": ["violationId", "code", "step", "at", "details"],
      "properties": {
        "violationId": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "step": { "$ref": "messages.schema.json#/$defs/penaltyStep" },
        "orderHash": { "$ref": "messages.schema.json#/$defs/bytes32" },
        "attempt": { "$ref": "messages.schema.json#/$defs/uint32" },
        "at": { "$ref": "messages.schema.json#/$defs/timeMs" },
        "details": { "type": "object" }
      }
    },
    "penaltyList": {
      "type": "object",
      "required": ["items", "nextCursor"],
      "properties": { "items": { "type": "array", "items": { "$ref": "#/$defs/penaltyRecord" } }, "nextCursor": { "type": ["string", "null"] } }
    },
    "cantonParty": {
      "type": "object",
      "description": "The filler's Canton party and its FillerRegistryEntry with the operator. party null: none allocated or registered yet (party.allocate). registry.state NONE: no proposal yet; PROPOSED: accept it (registry.accept); ACTIVE: the Canton routes may be activated; REMOVED: staff removed the entry",
      "required": ["party", "publicKey", "registry"],
      "properties": {
        "party": { "type": ["string", "null"], "minLength": 1 },
        "publicKey": { "anyOf": [{ "$ref": "messages.schema.json#/$defs/edPublicKey" }, { "type": "null" }] },
        "registry": {
          "type": "object",
          "required": ["state", "proposalCid", "entryCid"],
          "properties": {
            "state": { "anyOf": [{ "enum": ["NONE", "PROPOSED", "ACTIVE", "REMOVED"] }, { "$ref": "messages.schema.json#/$defs/futureEnumValue" }] },
            "proposalCid": { "type": ["string", "null"] },
            "entryCid": { "type": ["string", "null"] }
          }
        }
      }
    },
    "cantonHolding": {
      "type": "object",
      "required": ["contractId", "asset", "amount", "locked"],
      "properties": {
        "contractId": { "type": "string", "minLength": 1 },
        "asset": { "$ref": "messages.schema.json#/$defs/cantonAsset" },
        "amount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,10})?$", "description": "Daml Decimal" },
        "locked": { "type": "boolean", "description": "held by a lock (an allocation or a pending transfer); not spendable by delivery.fill" }
      }
    },
    "cantonHoldingList": {
      "type": "object",
      "description": "Holdings of the party (CNRX and Canton Coin among them), oldest first",
      "required": ["items", "nextCursor"],
      "properties": { "items": { "type": "array", "items": { "$ref": "#/$defs/cantonHolding" } }, "nextCursor": { "type": ["string", "null"] } }
    },
    "cantonDeliveryOrder": {
      "type": "object",
      "required": ["deliveryOrderCid", "orderHash", "attempt", "asset", "amount", "recipient", "repayTo", "validUntil"],
      "properties": {
        "deliveryOrderCid": { "type": "string", "minLength": 1 },
        "orderHash": { "$ref": "messages.schema.json#/$defs/bytes32" },
        "attempt": { "$ref": "messages.schema.json#/$defs/uint32" },
        "asset": { "$ref": "messages.schema.json#/$defs/cantonAsset" },
        "amount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,10})?$", "description": "Daml Decimal" },
        "recipient": { "type": "string", "minLength": 1 },
        "repayTo": { "$ref": "messages.schema.json#/$defs/repayTo" },
        "validUntil": { "$ref": "messages.schema.json#/$defs/timeS" }
      }
    },
    "cantonDeliveryOrderList": {
      "type": "object",
      "description": "The live DeliveryOrders naming the party as filler, oldest first",
      "required": ["items", "nextCursor"],
      "properties": { "items": { "type": "array", "items": { "$ref": "#/$defs/cantonDeliveryOrder" } }, "nextCursor": { "type": ["string", "null"] } }
    },
    "cantonIntent": {
      "type": "object",
      "description": "A live SwapIntent of a Canton source that names the caller's party as its filler, as that party sees it (an observer), with its committed allocation as the operator reads it (an executor). What the node checks before ticket.receipt (fillers.md V-C1…V-C6); the node recomputes orderHash from these fields itself. 404 UNKNOWN_TICKET when no live SwapIntent with this orderHash names the party; 409 CANTON_NOT_READY when the fillerId has no party",
      "required": ["intentCid", "templateId", "orderHash", "owner", "operator", "filler", "fillerId", "requestId", "asset", "amount", "destination", "minReceived", "feeRate", "fillDeadline", "refundAfter", "orderCreatedAt", "allocationCid", "allocation"],
      "properties": {
        "intentCid": { "type": "string", "minLength": 1 },
        "templateId": { "type": "string", "pattern": "^[0-9a-f]{64}:[A-Za-z0-9_.]+:[A-Za-z0-9_]+$", "description": "<package id>:Intent.SwapIntent:SwapIntent" },
        "orderHash": { "$ref": "messages.schema.json#/$defs/bytes32" },
        "owner": { "type": "string", "minLength": 1 },
        "operator": { "type": "string", "minLength": 1 },
        "filler": { "type": "string", "minLength": 1 },
        "fillerId": { "type": "string", "minLength": 1 },
        "requestId": { "type": "string", "minLength": 1 },
        "asset": { "$ref": "messages.schema.json#/$defs/cantonAsset", "description": "SwapIntent.instrumentId" },
        "amount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,10})?$", "description": "Daml Decimal", "description": "the committed give, fee-inclusive" },
        "destination": {
          "type": "object",
          "description": "an EVM destination (Destination.Evm); an intent to any other destination is not served",
          "required": ["chainId", "token", "recipient"],
          "properties": {
            "chainId": { "$ref": "messages.schema.json#/$defs/uintDec64" },
            "token": { "$ref": "messages.schema.json#/$defs/address" },
            "recipient": { "$ref": "messages.schema.json#/$defs/address" }
          }
        },
        "minReceived": {
          "type": "object",
          "required": ["units", "decimals"],
          "properties": { "units": { "$ref": "messages.schema.json#/$defs/uintDec256" }, "decimals": { "type": "integer", "minimum": 0, "maximum": 255 } }
        },
        "feeRate": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,10})?$", "description": "Daml Decimal" },
        "fillDeadline": { "$ref": "messages.schema.json#/$defs/timeS" },
        "refundAfter": { "$ref": "messages.schema.json#/$defs/timeS" },
        "orderCreatedAt": { "$ref": "messages.schema.json#/$defs/timeS", "description": "the owner's signing time: the order's createdAt" },
        "allocationCid": { "type": "string", "minLength": 1, "description": "SwapIntent.allocationCid" },
        "allocation": {
          "anyOf": [{ "$ref": "#/$defs/cantonAllocation" }, { "type": "null" }],
          "description": "the contract allocationCid names, by its AllocationV2 view; null when it is not live"
        }
      }
    },
    "cantonAllocation": {
      "type": "object",
      "required": ["contractId", "templateId", "admin", "authorizer", "committed", "settlementId", "executors", "settlementDeadline", "legs"],
      "properties": {
        "contractId": { "type": "string", "minLength": 1 },
        "templateId": { "type": "string", "pattern": "^[0-9a-f]{64}:[A-Za-z0-9_.]+:[A-Za-z0-9_]+$" },
        "admin": { "type": "string", "minLength": 1 },
        "authorizer": { "type": ["string", "null"], "minLength": 1, "description": "the owner of the authorizer account; null for an account without one" },
        "committed": { "type": "boolean" },
        "settlementId": { "type": "string" },
        "executors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "settlementDeadline": { "anyOf": [{ "$ref": "messages.schema.json#/$defs/timeS" }, { "type": "null" }] },
        "legs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["legId", "side", "otherside", "amount", "instrumentId"],
            "properties": {
              "legId": { "type": "string" },
              "side": { "enum": ["SENDER", "RECEIVER"] },
              "otherside": { "type": ["string", "null"], "minLength": 1, "description": "the owner of the other side's account" },
              "amount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,10})?$", "description": "Daml Decimal" },
              "instrumentId": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
