{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Cancore filler protocol",
    "version": "1.0.0-rc.1",
    "description": "The WebSocket protocol between a filler and the Cancore filler gateway, v1 (release candidate). Operations are the gateway's: it sends S→F frames and receives F→S frames. Every frame carries id, fillerId and sentAt and is signed in the CancoreFillerProtocol v1 domain: S→F with sig = the gateway key over GatewayMessage{bodyHash}, F→S with msgSig = the filler's message key over FillerMessage{bodyHash}, bodyHash = keccak256(JCS(frame without that field)). Payload schemas: messages.schema.json. Generated by scripts/gen-protocol-docs.mjs.",
    "license": {
      "name": "Apache-2.0"
    }
  },
  "defaultContentType": "application/json",
  "servers": {
    "devnet": {
      "host": "{gatewayHost}",
      "protocol": "wss",
      "description": "Published per environment (O-6)",
      "variables": {
        "gatewayHost": {
          "default": "filler.dev.cancore.io"
        }
      }
    }
  },
  "channels": {
    "filler": {
      "address": "/v1",
      "description": "One JSON object per text frame. Nothing but auth.* and error flows before auth.ok; FillerAuth in auth.response authenticates the socket (the REST fallback uses a bearer token).",
