{
  "name": "@cancore/contracts",
  "version": "0.2.0-rc.6",
  "type": "module",
  "description": "The Cancore EVM contracts as data: the ABIs of the Cancore EVM contracts and their custom-error selectors, the EIP-712 FeeClaim voucher and FillProof, the network registry; and the filler protocol v1: EIP-712 types and domains, hashing helpers, JSON Schemas, AsyncAPI, golden vectors.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./abi": {
      "types": "./dist/abi.d.ts",
      "import": "./dist/abi.js",
      "default": "./dist/abi.js"
    },
    "./networks": {
      "types": "./dist/networks.d.ts",
      "import": "./dist/networks.js",
      "default": "./dist/networks.js"
    },
    "./spec/*": "./spec/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cancore-io/sdk.git",
    "directory": "packages/contracts"
  },
  "homepage": "https://docs.cancore.io/sdk/contracts",
  "bugs": {
    "url": "https://github.com/Cancore-io/sdk/issues"
  },
  "keywords": ["canton", "cancore", "abi", "htlc", "evm", "eip-712", "contracts", "filler-protocol", "asyncapi", "json-schema"],
  "files": ["dist", "spec", "README.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsup",
    "prepack": "tsup --silent",
    "prepublishOnly": "npm run build",
    "sync": "node scripts/sync.mjs && node scripts/sync-typed-data.mjs",
    "vectors": "node scripts/gen-protocol-vectors.mjs && node scripts/gen-protocol-docs.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0"
  }
}
