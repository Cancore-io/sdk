{
  "name": "@cancore/client",
  "version": "0.4.0",
  "type": "module",
  "description": "A typed client for the Cancore API: orders and pool trades (./swap), USDCx bridge (./bridge), live order updates (./realtime), scoped trading grants by device flow (./auth). No keys \u2014 signing stays with @cancore/wallet or the dApp connector.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./swap": {
      "types": "./dist/swap.d.ts",
      "import": "./dist/swap.js",
      "default": "./dist/swap.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js",
      "default": "./dist/bridge.js"
    },
    "./realtime": {
      "types": "./dist/realtime.d.ts",
      "import": "./dist/realtime.js",
      "default": "./dist/realtime.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js",
      "default": "./dist/auth.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cancore-io/sdk.git",
    "directory": "packages/client"
  },
  "homepage": "https://docs.cancore.io/sdk/client",
  "bugs": {
    "url": "https://github.com/Cancore-io/sdk/issues"
  },
  "keywords": [
    "canton",
    "cancore",
    "swap",
    "bridge",
    "usdcx",
    "trading",
    "api-client",
    "device-flow"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "tsup --silent",
    "prepublishOnly": "npm run build",
    "spec:refresh": "node scripts/refresh-spec.mjs"
  }
}
