{
  "name": "@cancore/wallet",
  "version": "0.4.2",
  "type": "module",
  "description": "Cancore wallet core — key material, signing and storage contracts. Runtime-agnostic: no browser, no React.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./operations": {
      "types": "./dist/operations.d.ts",
      "import": "./dist/operations.js",
      "default": "./dist/operations.js"
    },
    "./canton": {
      "types": "./dist/canton/index.d.ts",
      "import": "./dist/canton/index.js",
      "default": "./dist/canton/index.js"
    },
    "./canton/proto": {
      "types": "./dist/canton/proto.d.ts",
      "import": "./dist/canton/proto.js",
      "default": "./dist/canton/proto.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js",
      "default": "./dist/web/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cancore-io/sdk.git",
    "directory": "packages/wallet"
  },
  "homepage": "https://docs.cancore.io/sdk/wallet",
  "bugs": {
    "url": "https://github.com/Cancore-io/sdk/issues"
  },
  "keywords": [
    "canton",
    "cancore",
    "wallet",
    "ed25519",
    "signing",
    "keystore",
    "webauthn",
    "bip39",
    "prepared-transaction"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "tsup --silent",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@canton-network/core-ledger-proto": "^1.13.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@protobuf-ts/runtime": "^2.11.1",
    "@scure/bip39": "^1.6.0"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@canton-network/core-tx-visualizer": "^1.13.0"
  }
}
