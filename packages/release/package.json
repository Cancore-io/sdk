{
  "name": "@cancore/release",
  "version": "0.1.0",
  "type": "module",
  "description": "One SemVer rule for every Cancore repo: the bump level from conventional commits or a Release-Bump: trailer, the vX.Y.Z tag cut on main, prerelease strings for dev and stage, and the browser-safe neighbour compatibility check behind /version. No dependencies.",
  "bin": {
    "cancore-release": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cancore-io/sdk.git",
    "directory": "packages/release"
  },
  "bugs": {
    "url": "https://github.com/Cancore-io/sdk/issues"
  },
  "keywords": [
    "semver",
    "release",
    "conventional-commits",
    "cancore",
    "compatibility"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=26"
  }
}
