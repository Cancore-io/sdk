# src/generated/<Name>.ts, index.ts and errors.ts are written by
# packages/contracts/scripts/sync.mjs from spec/abi/*.json. typedData.ts is
# written by sync-typed-data.mjs from spec/typed-data/*.json. CI re-derives
# them: packages/contracts/src/generated.test.ts renders each from the JSON with
# the same code (scripts/render.cjs) and compares the whole file byte for byte,
# and pins the set of files in the directory. Marking them generated folds them
# in GitHub diffs and keeps them out of the review size budget; the JSON they
# mirror stays reviewable.
packages/contracts/src/generated/*.ts linguist-generated=true
# Not derivable from spec/ alone, so a reviewer reads it: meta.ts carries the
# release identity and bytecode hashes.
packages/contracts/src/generated/meta.ts -linguist-generated
# Rewritten whole by packages/client/scripts/refresh-spec.mjs from the deployed
# gateway document (daily client-spec-refresh); packages/client/src/spec.test.ts
# checks what the client derives from it. Folded in diffs and out of the review
# size budget; the script and the test stay reviewable.
packages/client/spec/openapi.json linguist-generated=true
